# =============================================================================
# RR EDGE — Git Ignore Configuration
# Protects against credential leaks, dependency bloat, and transient files
# =============================================================================

# Environments & Credentials (STRICT PROTECTION)
.env
.env.*
*.env
*.key
*.pem
*.cert
*.pfx
*.p12
credentials.json
client_secret*.json
secrets/
tokens/

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
!frontend/dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# Testing & Linters
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node & Frontend Dependencies
node_modules/
frontend/node_modules/
.npm
.eslintcache

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Temporary & Local Scratch Artifacts
*.tmp
*.temp
~$*
scratch/
audit_evidence_tier.py
bowler_table.png
